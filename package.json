{
  "name": "victor-ai-agent",
  "version": "1.0.0",
  "description": "Victor: an autonomous AI representative that answers recruiters and clients about my career, maps job specs to evidence, scopes builds and books meetings, with hard guardrails. LangGraph.js + typed tools.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndanetaadmire-debug/victor-ai-agent.git"
  },
  "keywords": [
    "langgraph",
    "ai-agent",
    "portfolio",
    "guardrails",
    "typescript"
  ],
  "author": "Admire T. Ndaneta",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ndanetaadmire-debug/commerce-ops-agent/issues"
  },
  "homepage": "https://github.com/ndanetaadmire-debug/commerce-ops-agent#readme",
  "dependencies": {
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "^1.7.4",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
